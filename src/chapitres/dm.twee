:: DM_Attendre [dm]
<<include "DM_Haut">>
<div class="typing">$prenomFille is typing...</div>
<<if $difficile>>
	<<timed 3s>><<remove ".typing">>
	<<next 2s>><div class="choix">[[?|DM_Silence_2]]</div>
	<</timed>>
<<else>>
	<<set $interet += 20>>
	<<timed 1s>><<remove ".typing">><div class="elle">hello?</div>
	<<next 1s>><div class="elle">HELLO??</div>
	<<next 1s>><div class="elle">did u die 😭</div>
	<<next 1s>><div class="elle">pls don't be dead I already told my mom about u</div>
	<<next 1s>><<include "DM_4_Lieu">>
	<</timed>>
<</if>>


