:: DM_4_Lieu
<<if not $difficile>><div class="elle">WE SHOULD MEET!!!! like TODAY. like NOW. where do u wanna go??</div><</if>>
<p class="info">Time to ask her out. Where?</p>
<div class="choix">
	[[Dinner at a restaurant? 🍝|DM_Reponse][$lieu to "Restaurant"]]
	[[A walk in the park? 🌳|DM_Reponse][$lieu to "Parc"]]
	[[Let's meet at my bank. I booked us an appointment with my financial advisor 💍|Fin_Banque]]
</div>

:: DM_Reponse [dm]
<<include "DM_Haut">>
<<if $lieu is "Restaurant">><div class="moi">Dinner at a restaurant? 🍝</div><<else>><div class="moi">A walk in the park? 🌳</div><</if>>
<div class="vu">Seen</div>
<div class="typing">$prenomFille is typing...</div>
<<if $interet lt 30>>
	<<timed 3s>><<remove ".typing">>
	<<next 2s>><p class="info">$prenomFille left you on Seen.</p>
	<<next 1s>><div class="choix">[[Wait for her answer...|Fin_Ghost]]</div>
	<</timed>>
<<elseif $difficile>>
	<<timed 2s>><<remove ".typing">><div class="elle">Fine.</div>
	<<next 1s>><div class="elle">15 minutes. You're paying.</div>
	<<next 1s>><div class="choix">[[📍 Go to the date|Trajet]]</div>
	<</timed>>
<<else>>
	<<timed 1s>><<remove ".typing">><div class="elle">YES YES YES 🐶🐶🐶</div>
	<<next 1s>><div class="elle">I'M ALREADY GETTING READY</div>
	<<next 1s>><div class="elle">(I've been ready since u said hi)</div>
	<<next 1s>><div class="choix">[[📍 Go to the date|Trajet]]</div>
	<</timed>>
<</if>>
